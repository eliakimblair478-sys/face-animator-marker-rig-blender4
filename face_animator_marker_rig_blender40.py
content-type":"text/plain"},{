class FACE_OT_generate_face_rig(bpy.types.Operator):
    bl_idname = "faceanimator.generate_face_rig"
    bl_label = "Generate Face Rig"

    def execute(self, context):
        obj = ensure_mesh_object(context)
        if obj is None:
            self.report({"WARNING"}, "Select a mesh object first.")
            return {"CANCELLED"}

        if obj.data is None:
            self.report({"WARNING"}, "Selected object has no mesh data.")
            return {"CANCELLED"}

        if obj.data.shape_keys is None:
            obj.shape_key_add(name="Basis")

        required_shapes = [
            "MouthOpen",
            "MouthSmile",
            "Blink",
            "BrowRaise",
            "RoundLips",
            "JawOpen"
        ]
        for name in required_shapes:
            ensure_shape_key(obj, name)

        rig_name = context.scene.face_animator.rig_name or "FaceRig"
        rig = bpy.data.objects.get(rig_name)
        if rig is None or rig.type != "ARMATURE":
            bpy.ops.object.armature_add(enter_editmode=True)
            rig = bpy.context.active_object
            rig.name = rig_name
            rig.location = obj.location
            bpy.ops.object.mode_set(mode='EDIT')
        else:
            bpy.context.view_layer.objects.active = rig
            if rig.mode != "EDIT":
                bpy.ops.object.mode_set(mode='EDIT')

        edit_bones = rig.data.edit_bones

        def ensure_bone(name, parent_name=None, head=(0, 0, 0), tail=(0, 0.05, 0)):
            bone = edit_bones.get(name)
            if bone is None:
                bone = edit_bones.new(name)
            bone.head = Vector(head)
            bone.tail = Vector(tail)
            if parent_name:
                parent = edit_bones.get(parent_name)
                if parent is not None:
                    bone.parent = parent
            return bone

        nose = get_marker_location("face_marker_nose", (0.0, 0.03, 0.10))
        jaw = get_marker_location("face_marker_jaw", (0.0, -0.20, 0.00))
        brow_l = get_marker_location("face_marker_brow_l", (-0.08, 0.08, 0.16))
        brow_r = get_marker_location("face_marker_brow_r", (0.08, 0.08, 0.16))
        eye_l = get_marker_location("face_marker_eye_l", (-0.06, 0.08, 0.08))
        eye_r = get_marker_location("face_marker_eye_r", (0.06, 0.08, 0.08))
        mouth_l = get_marker_location("face_marker_mouth_l", (-0.08, -0.08, 0.00))
        mouth_r = get_marker_location("face_marker_mouth_r", (0.08, -0.08, 0.00))
        upper_lip = get_marker_location("face_marker_upper_lip", (0.00, -0.10, 0.00))
        lower_lip = get_marker_location("face_marker_lower_lip", (0.00, -0.14, -0.02))

        ensure_bone("root", None, (0, 0, 0), (0, 0, 0.12))
        ensure_bone("head", "root", nose, nose + Vector((0, 0, 0.12)))
        ensure_bone("jaw", "head", jaw, jaw + Vector((0, 0.04, 0)))
        ensure_bone("brow_l", "head", brow_l, brow_l + Vector((0, 0, 0.05)))
        ensure_bone("brow_r", "head", brow_r, brow_r + Vector((0, 0, 0.05)))
        ensure_bone("eye_l", "head", eye_l, eye_l + Vector((0, 0, 0.04)))
        ensure_bone("eye_r", "head", eye_r, eye_r + Vector((0, 0, 0.04)))
        ensure_bone("mouth_l", "head", mouth_l, mouth_l + Vector((0, 0.04, 0)))
        ensure_bone("mouth_r", "head", mouth_r, mouth_r + Vector((0, 0.04, 0)))
        ensure_bone("upper_lip", "head", upper_lip, upper_lip + Vector((0, 0.04, 0)))
        ensure_bone("lower_lip", "head", lower_lip, lower_lip + Vector((0, 0.04, 0)))

        bpy.ops.object.mode_set(mode='OBJECT')
        obj.parent = rig

        self.report({"INFO"}, f"Face rig generated: {rig_name}")
        return {"FINISHED"}


class FACE_OT_apply_marker_morphs(bpy.types.Operator):
    bl_idname = "faceanimator.apply_marker_morphs"
    bl_label = "Apply Marker Morphs"

    def execute(self, context):
        obj = ensure_mesh_object(context)
        if obj is None:
            self.report({"WARNING"}, "Select a mesh object first.")
            return {"CANCELLED"}

        mouth_l = get_marker_location("face_marker_mouth_l", (-0.08, -0.08, 0.0))
        mouth_r = get_marker_location("face_marker_mouth_r", (0.08, -0.08, 0.0))
        upper_lip = get_marker_location("face_marker_upper_lip", (0.0, -0.10, 0.0))
        lower_lip = get_marker_location("face_marker_lower_lip", (0.0, -0.14, -0.02))
        brow_l = get_marker_location("face_marker_brow_l", (-0.08, 0.08, 0.16))
        brow_r = get_marker_location("face_marker_brow_r", (0.08, 0.08, 0.16))
        eye_l = get_marker_location("face_marker_eye_l", (-0.06, 0.08, 0.08))
        eye_r = get_marker_location("face_marker_eye_r", (0.06, 0.08, 0.08))
        jaw = get_marker_location("face_marker_jaw", (0.0, -0.20, 0.0))
        nose = get_marker_location("face_marker_nose", (0.0, 0.03, 0.10))

        mouth_open = clamp(abs((upper_lip.z - lower_lip.z)) * 12.0, 0.0, 1.0)
        smile = clamp(abs(mouth_l.x - mouth_r.x) * 6.0, 0.0, 1.0)
        brow_raise_l = clamp((brow_l.z - eye_l.z) * 8.0, 0.0, 1.0)
        brow_raise_r = clamp((brow_r.z - eye_r.z) * 8.0, 0.0, 1.0)
        jaw_open = clamp(abs(jaw.z - nose.z) * 8.0, 0.0, 1.0)
        round_lips = clamp(abs(upper_lip.z - lower_lip.z) * 6.0, 0.0, 1.0)

        shape_values = {
            "MouthOpen": mouth_open,
            "MouthSmile": smile,
            "Blink": clamp((0.5 - abs(eye_l.y - eye_r.y)) * 3.0, 0.0, 1.0),
            "BrowRaise": max(brow_raise_l, brow_raise_r),
            "RoundLips": round_lips,
            "JawOpen": jaw_open,
        }

        for name in shape_values:
            ensure_shape_key(obj, name)

        current_frame = context.scene.frame_current
        for name, value in shape_values.items():
            shape_key = ensure_shape_key(obj, name)
            if shape_key is not None:
                shape_key.value = value
                shape_key.keyframe_insert(data_path="value", frame=current_frame)

        self.report({"INFO"}, "Marker morph values applied.")
        return {"FINISHED"}


