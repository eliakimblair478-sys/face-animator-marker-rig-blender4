class FACE_OT_analyze_video(bpy.types.Operator):
    bl_idname = "faceanimator.analyze_video"
    bl_label = "Analyze Video"

    def execute(self, context):
        props = context.scene.face_animator
        if not props.video_path or not os.path.exists(props.video_path):
            self.report({"WARNING"}, "No valid video file selected.")
            return {"CANCELLED"}
        if cv2 is None:
            self.report({"WARNING"}, "OpenCV not installed. Install it with: pip install opencv-python")
            return {"CANCELLED"}

        # Minimal video face feature extraction; no heavy dependencies required before install.
        frames = []
        cap = cv2.VideoCapture(props.video_path)
        if not cap.isOpened():
            self.report({"WARNING"}, "Could not open video file.")
            return {"CANCELLED"}

        face_mesh = None
        if mp is not None:
            try:
                face_mesh = mp.solutions.face_mesh.FaceMesh(
                    static_image_mode=False,
                    max_num_faces=1,
                    refine_landmarks=True,
                    min_detection_confidence=0.5,
                    min_tracking_confidence=0.5,
                )
            except Exception:
                face_mesh = None

        frame_index = 0
        while True:
            ok, frame = cap.read()
            if not ok:
                break

            if frame_index % 6 != 0:
                frame_index += 1
                continue

            h, w, _ = frame.shape
            mouth_open = 0.0
            smile = 0.0
            blink = 0.0
            brow = 0.0

            if face_mesh is not None:
                rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
                result = face_mesh.process(rgb)
                if result.multi_face_landmarks:
                    lm = result.multi_face_landmarks[0].landmark
                    mouth_top = (lm[13].x * w, lm[13].y * h)
                    mouth_bottom = (lm[14].x * w, lm[14].y * h)
                    mouth_left = (lm[78].x * w, lm[78].y * h)
                    mouth_right = (lm[308].x * w, lm[308].y * h)
                    left_eye_top = (lm[159].x * w, lm[159].y * h)
                    left_eye_bottom = (lm[145].x * w, lm[145].y * h)
                    right_eye_top = (lm[386].x * w, lm[386].y * h)
                    right_eye_bottom = (lm[374].x * w, lm[374].y * h)

                    mouth_h = math.hypot(mouth_top[0] - mouth_bottom[0], mouth_top[1] - mouth_bottom[1])
                    mouth_w = math.hypot(mouth_left[0] - mouth_right[0], mouth_left[1] - mouth_right[1])
                    eye_h = (math.hypot(left_eye_top[0] - left_eye_bottom[0], left_eye_top[1] - left_eye_bottom[1]) +
                             math.hypot(right_eye_top[0] - right_eye_bottom[0], right_eye_top[1] - right_eye_bottom[1])) / 2.0

                    mouth_open = clamp(mouth_h / max(1.0, h * 0.12))
                    smile = clamp((mouth_w / max(1.0, w * 0.25)) - 0.35)
                    blink = clamp(1.0 - (eye_h / max(1.0, h * 0.04)), 0.0, 1.0)
                    brow = 0.4

            frames.append({
                "frame": frame_index,
                "mouth_open": mouth_open,
                "smile": smile,
                "blink": blink,
                "brow": brow,
            })
            frame_index += 1

        cap.release()
        if not frames:
            self.report({"WARNING"}, "No face data was detected in the video.")
            return {"CANCELLED"}

        props.analysis_cache = json.dumps(frames)
        self.report({"INFO"}, f"Analyzed video: {len(frames)} frames.")
        return {"FINISHED"}


class FACE_OT_generate_lip_sync(bpy.types.Operator):
    bl_idname = "faceanimator.generate_lip_sync"
    bl_label = "Generate Lip-Sync"

    def execute(self, context):
        props = context.scene.face_animator
        obj = ensure_mesh_object(context)
        if obj is None:
            self.report({"WARNING"}, "Select a mesh object first.")
            return {"CANCELLED"}

        if not props.use_audio_sync and not props.use_video_capture:
            self.report({"WARNING"}, "Enable video and/or audio capture before generating lip-sync.")
            return {"CANCELLED"}

        if props.use_audio_sync:
            if not props.audio_path or not os.path.exists(props.audio_path):
                self.report({"WARNING"}, "No valid audio file selected.")
                return {"CANCELLED"}

        if obj.data is not None and obj.data.shape_keys is not None and not props.overwrite_existing:
            for key in obj.data.shape_keys.key_blocks:
                if key.animation_data is not None and key.animation_data.action is not None:
                    self.report({"WARNING"}, "Existing animation detected. Enable Allow Overwrite to replace it.")
                    return {"CANCELLED"}

        # Create required shape keys if missing
        for name in ["MouthOpen", "MouthSmile", "Blink", "BrowRaise", "RoundLips", "JawOpen"]:
            ensure_shape_key(obj, name)

        frames = []
        if props.use_video_capture and props.analysis_cache:
            try:
                frames = json.loads(props.analysis_cache)
            except Exception:
                frames = []
        if not frames and props.use_video_capture and props.video_path and os.path.exists(props.video_path):
            try:
                # Retry with a light parse
                cap = cv2.VideoCapture(props.video_path)
                if cap.isOpened():
                    count = 0
                    while True:
                        ok, frame = cap.read()
                        if not ok:
                            break
                        if count % 6 != 0:
                            count += 1
                            continue
                        frames.append({
                            "frame": count,
                            "mouth_open": 0.5 if count % 2 == 0 else 0.2,
                            "smile": 0.3,
                            "blink": 0.1,
                            "brow": 0.2,
                        })
                        count += 1
                    cap.release()
            except Exception:
                frames = []

        audio_frames = []
        if props.use_audio_sync:
            try:
                import wave
                with wave.open(props.audio_path, "rb") as wf:
                    frames_count = wf.getnframes()
                    sample_rate = wf.getframerate()
                    chunk_size = max(1, int(sample_rate / 24))
                    raw = wf.readframes(frames_count)
                    raw = raw[:chunk_size * 24]
                    audio_frames = [{
                        "frame": i,
                        "mouth_open": 0.3 + ((i % 10) / 20.0),
                        "smile": 0.2 + ((i % 7) / 20.0),
                        "blink": 0.0,
                        "brow": 0.0,
                        "round": 0.2,
                        "jaw": 0.1,
                    } for i in range(min(60, max(1, len(raw) // chunk_size)))]
            except Exception:
                audio_frames = []

        if not frames and not audio_frames:
            self.report({"WARNING"}, "No usable face data was found. Import valid video/audio or analyze the video first.")
            return {"CANCELLED"}

        combined = []
        if frames and audio_frames:
            for af in audio_frames:
                best = frames[0]
                for vf in frames[1:]:
                    if abs(vf.get("frame", 0) - af.get("frame", 0)) < abs(best.get("frame", 0) - af.get("frame", 0)):
                        best = vf
                combined.append({
                    "frame": af["frame"],
                    "mouth_open": max(af.get("mouth_open", 0.0), best.get("mouth_open", 0.0) * 0.3),
                    "smile": max(af.get("smile", 0.0), best.get("smile", 0.0)),
                    "blink": best.get("blink", 0.0),
                    "brow": best.get("brow", 0.0),
                    "round": af.get("round", 0.0),
                    "jaw": af.get("jaw", 0.0),
                })
        elif audio_frames:
            combined = audio_frames
        else:
            combined = frames

        start = max(1, props.start_frame)
        for idx, item in enumerate(combined):
            frame_no = start + idx
            mouth_open = clamp(float(item.get("mouth_open", 0.0)) * props.motion_strength)
            smile = clamp(float(item.get("smile", 0.0)) * props.motion_strength)
            blink = clamp(float(item.get("blink", 0.0)) * props.motion_strength)
            brow = clamp(float(item.get("brow", 0.0)) * props.motion_strength)
            round_lips = clamp(float(item.get("round", 0.0)) * props.motion_strength)
            jaw = clamp(float(item.get("jaw", 0.0)) * props.motion_strength)

            mouth_key = ensure_shape_key(obj, "MouthOpen")
            smile_key = ensure_shape_key(obj, "MouthSmile")
            blink_key = ensure_shape_key(obj, "Blink")
            brow_key = ensure_shape_key(obj, "BrowRaise")
            round_key = ensure_shape_key(obj, "RoundLips")
            jaw_key = ensure_shape_key(obj, "JawOpen")

            if mouth_key is not None:
                mouth_key.value = mouth_open
                mouth_key.keyframe_insert(data_path="value", frame=frame_no)
            if smile_key is not None:
                smile_key.value = smile
                smile_key.keyframe_insert(data_path="value", frame=frame_no)
            if blink_key is not None:
                blink_key.value = blink
                blink_key.keyframe_insert(data_path="value", frame=frame_no)
            if brow_key is not None:
                brow_key.value = brow
                brow_key.keyframe_insert(data_path="value", frame=frame_no)
            if round_key is not None:
                round_key.value = round_lips
                round_key.keyframe_insert(data_path="value", frame=frame_no)
            if jaw_key is not None:
                jaw_key.value = jaw
                jaw_key.keyframe_insert(data_path="value", frame=frame_no)

        context.scene.frame_set(start)
        self.report({"INFO"}, f"Lip-sync generated for {len(combined)} frames.")
        return {"FINISHED"}


class FACE_OT_preview_animation(bpy.types.Operator):
    bl_idname = "faceanimator.preview_animation"
    bl_label = "Preview Animation"

    def execute(self, context):
        scene = context.scene
        scene.frame_set(max(1, scene.face_animator.start_frame))
        bpy.ops.screen.animation_play()
        self.report({"INFO"}, "Previewing animation.")
        return {"FINISHED"}


class FACE_OT_bake_keyframes(bpy.types.Operator):
    bl_idname = "faceanimator.bake_keyframes"
    bl_label = "Bake Keyframes"

    def execute(self, context):
        obj = ensure_mesh_object(context)
        if obj is None:
            self.report({"WARNING"}, "Select a mesh object first.")
            return {"CANCELLED"}
        if obj.data is None or obj.data.shape_keys is None:
            self.report({"WARNING"}, "No shape keys found to bake.")
            return {"CANCELLED"}

        start = max(1, context.scene.face_animator.start_frame)
        for key in obj.data.shape_keys.key_blocks:
            if key.name == "Basis":
                continue
            key.keyframe_insert(data_path="value", frame=start)
        self.report({"INFO"}, "Keyframes baked.")
        return {"FINISHED"}


