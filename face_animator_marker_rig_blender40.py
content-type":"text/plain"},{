# -------------------------------
# Utility functions
# -------------------------------
def clamp(value, minimum=0.0, maximum=1.0):
    return max(minimum, min(maximum, value))


def ensure_mesh_object(context):
    obj = context.active_object
    if obj is None:
        return None
    if obj.type != "MESH":
        return None
    return obj


def ensure_shape_key(obj, name):
    if obj is None or obj.type != "MESH":
        return None
    if obj.data is None:
        return None
    if obj.data.shape_keys is None:
        obj.shape_key_add(name="Basis")
    shape_keys = obj.data.shape_keys
    key = shape_keys.key_blocks.get(name)
    if key is None:
        key = obj.shape_key_add(name=name)
    return key


def create_or_get_collection(name):
    coll = bpy.data.collections.get(name)
    if coll is None:
        coll = bpy.data.collections.new(name)
        bpy.context.scene.collection.children.link(coll)
    return coll


def add_marker_empty(name, location, collection=None):
    obj = bpy.data.objects.get(name)
    if obj is not None:
        obj.location = location
        return obj

    bpy.ops.object.empty_add(type='PLAIN_AXES', location=location)
    obj = bpy.context.active_object
    obj.name = name
    obj.empty_display_size = 0.04
    obj["face_marker"] = True
    obj["marker_role"] = name

    if collection is not None:
        if obj.name not in collection.objects:
            collection.objects.link(obj)

    return obj


def get_marker_location(name, default=(0.0, 0.0, 0.0)):
    obj = bpy.data.objects.get(name)
    if obj is not None:
        return Vector(obj.location)
    return Vector(default)


def get_shape_key_names(obj):
    if obj is None or obj.type != "MESH" or obj.data is None or obj.data.shape_keys is None:
        return []
    return [k.name for k in obj.data.shape_keys.key_blocks]


