class FACE_OT_select_character(bpy.types.Operator):
    bl_idname = "faceanimator.select_character"
    bl_label = "Select Character"

    def execute(self, context):
        obj = context.active_object
        if obj is None:
            self.report({"WARNING"}, "Select a mesh object first.")
            return {"CANCELLED"}
        if obj.type != "MESH":
            self.report({"WARNING"}, "Selected object must be a mesh.")
            return {"CANCELLED"}

        context.scene.face_animator.character = obj
        self.report({"INFO"}, f"Selected character: {obj.name}")
        return {"FINISHED"}


class FACE_OT_add_default_markers(bpy.types.Operator):
    bl_idname = "faceanimator.add_default_markers"
    bl_label = "Add Default Markers"

    def execute(self, context):
        obj = ensure_mesh_object(context)
        if obj is None:
            self.report({"WARNING"}, "Select a mesh object first.")
            return {"CANCELLED"}

        coll = create_or_get_collection(context.scene.face_animator.marker_collection or "FaceMarkers")
        base = obj.matrix_world.to_translation()

        for name, offset in DEFAULT_MARKERS.items():
            loc = base + Vector(offset)
            add_marker_empty(name, loc, coll)

        self.report({"INFO"}, "Created default face markers.")
        return {"FINISHED"}


class FACE_OT_add_marker_cursor(bpy.types.Operator):
    bl_idname = "faceanimator.add_marker_cursor"
    bl_label = "Add Marker at Cursor"

    def execute(self, context):
        coll = create_or_get_collection(context.scene.face_animator.marker_collection or "FaceMarkers")
        loc = context.scene.cursor.location.copy()
        name = f"face_marker_custom_{len(bpy.data.objects)}"
        add_marker_empty(name, loc, coll)
        self.report({"INFO"}, f"Marker added: {name}")
        return {"FINISHED"}


