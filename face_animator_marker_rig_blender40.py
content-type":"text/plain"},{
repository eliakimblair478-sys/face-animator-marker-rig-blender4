classes = (
    FaceMarkerRigProperties,
    FACE_OT_select_character,
    FACE_OT_add_default_markers,
    FACE_OT_add_marker_cursor,
    FACE_OT_generate_face_rig,
    FACE_OT_apply_marker_morphs,
    FACE_OT_import_video,
    FACE_OT_import_audio,
    FACE_OT_analyze_video,
    FACE_OT_generate_lip_sync,
    FACE_OT_preview_animation,
    FACE_OT_bake_keyframes,
    FACE_PT_panel,
)


def register():
    for cls in classes:
        bpy.utils.register_class(cls)
    bpy.types.Scene.face_animator = bpy.props.PointerProperty(type=FaceMarkerRigProperties)


def unregister():
    for cls in reversed(classes):
        bpy.utils.unregister_class(cls)
    del bpy.types.Scene.face_animator


if __name__ == "__main__":
    register()
